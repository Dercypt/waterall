<resources>
    <style name="Theme.Waterall" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorPrimaryVariant">@color/ink</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorControlNormal">@color/ink_faint</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:textColorHint">@color/ink_faint</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="buttonStyle">@style/Waterall.Button</item>
    </style>

    <style name="Waterall.Button" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Typography -->
    <style name="Waterall.Label" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="Waterall.Body" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Waterall.Caption" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/ink_muted</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="Waterall.Metric" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="Waterall.Input" parent="">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Waterall.Nav" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
