<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_white"
    android:padding="14dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvScheduleDayBadge"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="#E2E8F0"
        android:text="M"
        android:textStyle="bold"
        android:textColor="@color/slate_700"
        android:gravity="center"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvScheduleDay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Mon 09"
        android:textStyle="bold"
        android:textColor="@color/slate_800"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvScheduleTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6:00 AM – 10:00 AM"
        android:textColor="@color/slate_500"
        android:textSize="12sp" />

</LinearLayout>
