<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="28dp"
        android:paddingBottom="16dp"
        android:paddingStart="20dp"
        android:paddingEnd="24dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:visibility="gone"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tvScreenTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/title_hydro_track"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.01"
            android:textColor="@color/ink" />

        <TextView
            style="@style/Waterall.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WATERALL · SDG 6"
            android:textColor="@color/ink_faint" />
    </LinearLayout>

    <!-- Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- ================= 1. CALENDAR VIEW ================= -->
            <LinearLayout
                android:id="@+id/viewCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Zone selector -->
                <TextView
                    style="@style/Waterall.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zone" />

                <Spinner
                    android:id="@+id/spinnerZones"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginStart="-8dp"
                    android:backgroundTint="@color/ink_muted" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hairline" />

                <!-- Live countdown -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="40dp"
                    android:paddingBottom="40dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <View
                            android:id="@+id/flowPulseDot"
                            android:layout_width="6dp"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_dot_active" />

                        <TextView
                            android:id="@+id/tvFlowBadge"
                            style="@style/Waterall.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Flow active"
                            android:textColor="@color/status_ok" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCountdownTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginStart="-3dp"
                        android:text="02:47:13"
                        android:textSize="60sp"
                        android:fontFamily="sans-serif-thin"
                        android:fontFeatureSettings="tnum"
                        android:letterSpacing="-0.02"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tvCountdownSubtext"
                        style="@style/Waterall.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remaining supply window time" />
                </LinearLayout>

                <!-- Schedule -->
                <TextView
                    style="@style/Waterall.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upcoming schedule"
                    android:layout_marginBottom="4dp" />

                <include
                    android:id="@+id/scheduleItem1"
                    layout="@layout/item_schedule_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/scheduleItem2"
                    layout="@layout/item_schedule_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="48dp"
                    android:background="@color/hairline" />

                <include
                    android:id="@+id/scheduleItem3"
                    layout="@layout/item_schedule_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Community consensus -->
                <TextView
                    style="@style/Waterall.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Community reports"
                    android:layout_marginTop="40dp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/cardZoneConsensus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_white"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:id="@+id/tvConsensusBadge"
                            style="@style/Waterall.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No reports"
                            android:textColor="@color/ink_muted" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvConsensusTimestamp"
                            style="@style/Waterall.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Today" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvConsensusSummary"
                        style="@style/Waterall.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No verified reports today"
                        android:textSize="15sp"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvConsensusDetails"
                        style="@style/Waterall.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Be the first to report for this zone."
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/tvConsensusAcknowledgment"
                        style="@style/Waterall.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_safe"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:text="Report recorded. Status refreshed."
                        android:textColor="@color/status_ok"
                        android:visibility="gone"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnQuickReport"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:minHeight="0dp"
                        android:text="Report tap status"
                        android:textSize="13sp"
                        android:background="@drawable/bg_button_outline"
                        android:textColor="@color/ink" />
                </LinearLayout>

            </LinearLayout>

            <!-- ================= 2. RESERVES VIEW (SDG 6 Exclusive Feature) ================= -->
            <LinearLayout
                android:id="@+id/viewReserves"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Waterall.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Track stored water to see whether it lasts until the next supply window."
                    android:textSize="13sp"
                    android:layout_marginBottom="32dp" />

                <!-- Storage inventory -->
                <TextView
                    style="@style/Waterall.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Storage"
                    android:layout_marginBottom="4dp" />

                <!-- 200L Blue Drums -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Waterall.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Blue drums" />

                        <TextView
                            style="@style/Waterall.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="200 L each" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDecrementDrums200L"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/ink_soft"
                        android:background="@drawable/bg_stepper_btn"
                        android:gravity="center" />

                    <EditText
                        android:id="@+id/etDrums200L"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:text="2"
                        android:gravity="center"
                        android:background="@android:color/transparent"
                        android:textSize="16sp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/ink"
                        android:importantForAutofill="no" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnIncrementDrums200L"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/ink_soft"
                        android:background="@drawable/bg_stepper_btn"
                        android:gravity="center" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hairline" />

                <!-- 1000L Overhead Tanks -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Waterall.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Overhead tanks" />

                        <TextView
                            style="@style/Waterall.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1,000 L each" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDecrementTanks1000L"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/ink_soft"
                        android:background="@drawable/bg_stepper_btn"
                        android:gravity="center" />

                    <EditText
                        android:id="@+id/etTanks1000L"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:text="0"
                        android:gravity="center"
                        android:background="@android:color/transparent"
                        android:textSize="16sp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/ink"
                        android:importantForAutofill="no" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnIncrementTanks1000L"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/ink_soft"
                        android:background="@drawable/bg_stepper_btn"
                        android:gravity="center" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/hairline" />

                <!-- 20L Slim / Gallons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Waterall.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Slim gallons" />

                        <TextView
                            style="@style/Waterall.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="20 L each" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnDecrementGallons20L"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="−"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/ink_soft"
                        android:background="@drawable/bg_stepper_btn"
                        android:gravity="center" />

                    <EditText
                        android:id="@+id/etGallons20L"
                        android:layout_width="48dp"
                        android:layout_height="36dp"
                        android:inputType="number"
                        android:text="2"
                        android:gravity="center"
                        android:background="@android:color/transparent"
                        android:textSize="16sp"
                        android:fontFeatureSettings="tnum"
                        android:textColor="@color/ink"
                        android:importantForAutofill="no" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnIncrementGallons20L"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        android:text="+"
                        android:textSize="18sp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/ink_soft"
                        android:background="@drawable/bg_stepper_btn"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Usage parameters -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="32dp">

                    <TextView
                        style="@style/Waterall.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Fill level" />

                    <TextView
                        android:id="@+id/tvFillPercentageDisplay"
                        style="@style/Waterall.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="100% · FULL"
                        android:textColor="@color/accent" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segment_track"
                    android:padding="4dp"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btnFillEmpty"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:minHeight="0dp"
                        android:text="0%"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill_inactive"
                        android:textColor="@color/ink_soft" />

                    <Button
                        android:id="@+id/btnFillQuarter"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:minHeight="0dp"
                        android:text="25%"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill_inactive"
                        android:textColor="@color/ink_soft" />

                    <Button
                        android:id="@+id/btnFillHalf"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:minHeight="0dp"
                        android:text="50%"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill_inactive"
                        android:textColor="@color/ink_soft" />

                    <Button
                        android:id="@+id/btnFillThreeQuarter"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:minHeight="0dp"
                        android:text="75%"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill_inactive"
                        android:textColor="@color/ink_soft" />

                    <Button
                        android:id="@+id/btnFillFull"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:minHeight="0dp"
                        android:text="100%"
                        android:textSize="12sp"
                        android:background="@drawable/bg_pill_active"
                        android:textColor="@color/white" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFillLevelHint"
                    style="@style/Waterall.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Full to the brim / top rim"
                    android:textColor="@color/ink_muted" />

                <TextView
                    style="@style/Waterall.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Daily use (L)"
                    android:layout_marginTop="28dp" />

                <EditText
                    android:id="@+id/etDailyConsumption"
                    style="@style/Waterall.Input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:inputType="numberDecimal"
                    android:text="200"
                    android:importantForAutofill="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="28dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Waterall.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hours to next supply" />

                        <TextView
                            android:id="@+id/tvScheduleSyncStatus"
                            style="@style/Waterall.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Synced with zone schedule"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSyncScheduleHours"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:text="Sync"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        android:textColor="@color/accent"
                        android:background="@drawable/bg_button_outline" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etHoursUntilNextSupply"
                    style="@style/Waterall.Input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:inputType="numberDecimal"
                    android:hint="Auto-calculated from schedule"
                    android:importantForAutofill="no" />

                <Button
                    android:id="@+id/btnCalculateRunout"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="32dp"
                    android:text="Calculate"
                    android:textSize="14sp"
                    android:background="@drawable/bg_pill_active"
                    android:textColor="@color/white" />

                <!-- Result -->
                <LinearLayout
                    android:id="@+id/cardRunoutStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_safe"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvRunoutStatusBadge"
                        style="@style/Waterall.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Surplus"
                        android:textColor="@color/status_ok" />

                    <TextView
                        android:id="@+id/tvRunoutStatusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="+12.0 hrs"
                        android:textSize="30sp"
                        android:fontFamily="sans-serif-light"
                        android:textColor="@color/status_ok" />

                    <TextView
                        android:id="@+id/tvRunoutStatusMessage"
                        style="@style/Waterall.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Your reserve will outlast the next supply window."
                        android:textSize="13sp"
                        android:textColor="@color/ink_soft" />

                    <!-- Recommended target -->
                    <LinearLayout
                        android:id="@+id/cardRecommendedTarget"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@drawable/bg_target_box_safe"
                        android:paddingStart="14dp"
                        android:layout_marginTop="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/tvTargetLabel"
                                style="@style/Waterall.Label"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Daily target"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvRecommendedTargetValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="≤ 160 L/day"
                                android:textSize="15sp"
                                android:fontFamily="sans-serif-medium"
                                android:textColor="@color/status_ok" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRecommendedTargetSubtext"
                            style="@style/Waterall.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Stay at or below target to keep your buffer." />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/hairline"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Waterall.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Stored"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvStoredCurrentVolume"
                                style="@style/Waterall.Metric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="440 L" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Waterall.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Capacity"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvStoredTotalCapacity"
                                style="@style/Waterall.Metric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="440 L" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Waterall.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lasts"
                                android:textSize="10sp" />

                            <TextView
                                android:id="@+id/tvRunoutHoursValue"
                                style="@style/Waterall.Metric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="52.8 hrs" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- ================= 3. REPORT / CROWDSOURCE VIEW ================= -->
            <LinearLayout
                android:id="@+id/viewReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Waterall.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Your zone" />

                <TextView
                    android:id="@+id/tvReportZoneName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Zone 4 — Brgy. San Isidro"
                    android:textSize="18sp"
                    android:textColor="@color/ink" />

                <TextView
                    style="@style/Waterall.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Water at your tap"
                    android:layout_marginTop="36dp"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/rgWaterStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="28dp">

                    <RadioButton
                        android:id="@+id/rbStatusRunning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:text="Running"
                        android:textSize="15sp"
                        android:textColor="@color/ink"
                        android:background="@drawable/bg_radio_option"
                        android:padding="18dp"
                        android:layout_marginBottom="10dp" />

                    <RadioButton
                        android:id="@+id/rbStatusLowPressure"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:text="Low pressure"
                        android:textSize="15sp"
                        android:textColor="@color/ink"
                        android:background="@drawable/bg_radio_option"
                        android:padding="18dp"
                        android:layout_marginBottom="10dp" />

                    <RadioButton
                        android:id="@+id/rbStatusDry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:button="@null"
                        android:text="Dry"
                        android:textSize="15sp"
                        android:textColor="@color/ink"
                        android:background="@drawable/bg_radio_option"
                        android:padding="18dp" />
                </RadioGroup>

                <TextView
                    style="@style/Waterall.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Note (optional)" />

                <EditText
                    android:id="@+id/etReportNotes"
                    style="@style/Waterall.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="top|start"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:hint="Pressure dropped around 7:15 AM"
                    android:textSize="14sp"
                    android:importantForAutofill="no"
                    android:layout_marginBottom="36dp" />

                <Button
                    android:id="@+id/btnSubmitReport"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Submit report"
                    android:textSize="14sp"
                    android:background="@drawable/bg_pill_active"
                    android:textColor="@color/white" />

                <TextView
                    style="@style/Waterall.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reports help refine distribution estimates for your zone."
                    android:textSize="11sp"
                    android:textColor="@color/ink_faint"
                    android:gravity="center"
                    android:layout_marginTop="12dp" />

            </LinearLayout>

        </FrameLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@color/paper"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/navCalendar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvNavCalendar"
                style="@style/Waterall.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_calendar"
                android:textColor="@color/ink" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navReserves"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvNavReserves"
                style="@style/Waterall.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_reserves"
                android:textColor="@color/ink_faint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navReport"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvNavReport"
                style="@style/Waterall.Nav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tab_report"
                android:textColor="@color/ink_faint" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
